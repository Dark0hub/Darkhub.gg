local function abrirLink(url)
    local abriu = false

    pcall(function()
        GuiService:OpenBrowserWindow(url)
        abriu = true
    end)

    if not abriu and setclipboard then
        pcall(function()
            setclipboard(url)
        end)
    end

    return abriu
end

