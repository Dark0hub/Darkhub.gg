-- ============ DRAG NA TELA DE KEY ============
local dragging = false
local dragStart, startPos

KeyFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        
        local objects = PlayerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
        local clicouBotao = false
        for _, obj in ipairs(objects) do
            if obj:IsA("TextButton") or obj:IsA("TextBox") then
                clicouBotao = true
                break
            end
        end
        
        if not clicouBotao then
            dragging = true
            dragStart = input.Position
            startPos = KeyFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        KeyFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ============ VALIDAÇÃO DA KEY ============
local function verificarKey()
    local keyDigitada = KeyInput.Text
    if keyDigitada == KEY_CORRETA then
        ErrorMsg.Text = "✅ Key válida! Carregando Dark Hub..."
        ErrorMsg.TextColor3 = Color3.fromRGB(100, 255, 120)
        task.wait(1)
        KeyGui:Destroy()
        if _G.CarregarDarkHub then
            _G.CarregarDarkHub()
        end
    else
        ErrorMsg.Text = "❌ Key incorreta. Tente novamente."
        ErrorMsg.TextColor3 = Color3.fromRGB(255, 80, 80)
        KeyInput.Text = ""
        local originalPos = InputFrame.Position
        for i = 1, 4 do
            InputFrame.Position = originalPos + UDim2.new(0, 6, 0, 0)
            task.wait(0.05)
            InputFrame.Position = originalPos - UDim2.new(0, 6, 0, 0)
            task.wait(0.05)
        end
        InputFrame.Position = originalPos
    end
end

SubmitBtn.MouseButton1Click:Connect(verificarKey)

KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        verificarKey()
    end
end)

